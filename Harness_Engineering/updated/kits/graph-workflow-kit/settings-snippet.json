{
  "permissions": {
    "ask": ["Agent", "Workflow"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
